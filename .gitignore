# Python / pixi
.pixi/
__pycache__/
*.pyc
.ipynb_checkpoints/
.pytest_cache/

# Data (large / regenerable by the pipeline)
data/raw/
data/layers/*.geojson
data/layers/*.geojson.gz
data/*.parquet
data/*.sqlite
# Exceptions: the backend API needs these three small files at runtime,
# and Vercel's build has no access to this machine's data/ directory --
# see vercel-deploy-prep branch notes / README. zcta_geometries.parquet
# (the ~200MB full-detail analysis geometry) stays ignored; the API only
# ever reads the much smaller render geometry.
!data/zcta_geometries_render.parquet
!data/zip_scores.parquet
!data/zip_to_zcta.parquet

# Node / frontend
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/tsconfig.tsbuildinfo
# Generated by scripts/copy-layers.mjs from data/layers/ -- not the
# source of truth, and still too large (hundreds of MB) to commit.
frontend/public/layers/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Env
.env
.env.local
